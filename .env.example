# ============================================================
# Stupidex — Environment Variables (Production on Square Cloud)
# ============================================================
# Copy to .env for local dev. Set via Square Cloud dashboard for production.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────
STUPIDEX_SERVER=1
STUPIDEX_DATA_DIR=./data
STUPIDEX_WORKSPACES_DIR=./data/workspaces
STUPIDEX_WORKERS=1
STUPIDEX_THREADS=8
STUPIDEX_TIMEOUT=300
STUPIDEX_LOG_LEVEL=info
FRONTEND_URL=https://stupidex.squareweb.app

# ── Shell (enabled with controls) ────────────────────────────
STUPIDEX_ENABLE_SHELL=1
STUPIDEX_SHELL_MODE=restricted
STUPIDEX_SHELL_MAX_TIMEOUT=120
STUPIDEX_SHELL_MAX_OUTPUT_BYTES=65536
STUPIDEX_SHELL_MAX_CONCURRENT_PER_USER=1
STUPIDEX_SHELL_MAX_CONCURRENT_GLOBAL=4
STUPIDEX_SHELL_REQUIRE_APPROVAL=1
STUPIDEX_SHELL_ALLOW_NETWORK=0

# ── Database (PostgreSQL for production, SQLite fallback) ────
# DATABASE_URL=postgresql://user:pass@host:5432/stupidex
# For local dev, leave unset — uses SQLite at STUPIDEX_DATA_DIR/stupidex.db

# ── Redis (required for rate limits, locks, job queue) ───────
# REDIS_URL=redis://user:pass@host:6379/0
# For local dev, leave unset — uses in-memory fallback

# ── Auth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stupidex.squareweb.app/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://stupidex.squareweb.app/api/integrations/github/callback

# ── LLM API Keys ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-substitua-pela-sua-chave
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── LiteLLM Gateway (optional, separate app) ─────────────────
# LITELLM_BASE_URL=https://litellm-stupidex.squareweb.app
# LITELLM_MASTER_KEY=sk-litellm-master-key

# ── CORS ─────────────────────────────────────────────────────
STUPIDEX_CORS=

# ── Limits ───────────────────────────────────────────────────
MAX_WORKSPACE_BYTES=200000000
MAX_WORKSPACE_FILES=10000
MAX_ARCHIVE_BYTES=50000000
MAX_FILE_BYTES=20971520
