# ============================================================
# Stupidex — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM API Key (required for chat) ────────────────────────
# Get yours at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-substitua-pela-sua-chave

# Optional: use your own API key per-provider
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Server ──────────────────────────────────────────────────
STUPIDEX_HOST=0.0.0.0
STUPIDEX_PORT=5000
STUPIDEX_DEBUG=0
# STUPIDEX_SERVER=1        # Set to 1 to force server mode
# STUPIDEX_WSGI=gunicorn   # Force gunicorn (default: waitress → gunicorn → flask)

# ── Data persistence ────────────────────────────────────────
# STUPIDEX_DATA_DIR=/data          # Where SQLite DB + workspaces live
# STUPIDEX_WORKSPACES_DIR=/data/workspaces

# ── Security ────────────────────────────────────────────────
# STUPIDEX_ENABLE_SHELL=1          # Enable shell tool (default: 1)
# STUPIDEX_SHELL_COMMANDS=python,python3,pytest,node,npm,git
# STUPIDEX_TOKEN=uma-senha-grande  # Legacy: simple bearer token auth

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Default: "*" in dev, "" in production.
# STUPIDEX_CORS=http://localhost:3000,http://localhost:5173

# ── Limits ──────────────────────────────────────────────────
# MAX_WORKSPACE_BYTES=200000000    # 200MB per workspace
# MAX_ARCHIVE_BYTES=50000000       # 50MB max zip upload

# ── Google OAuth (login) ────────────────────────────────────
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── GitHub OAuth (private repo access) ──────────────────────
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret
# GITHUB_REDIRECT_URI=http://localhost:5000/api/integrations/github/callback
# FRONTEND_URL=http://localhost:5000
# GITHUB_PAT=ghp_...  # Server-wide PAT for system-wide repo access
